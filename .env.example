# Salin menjadi .env.local untuk pengembangan. Jangan pernah commit nilai asli.

# URL produksi situs (dipakai untuk canonical, sitemap, robots, Open Graph).
# Domain final: https://purplecatering.biz.id. Isi hanya bila ingin override;
# bila dikosongkan, kode memakai domain ini sebagai fallback.
NEXT_PUBLIC_SITE_URL=https://purplecatering.biz.id

# Verifikasi Google Search Console (nilai dari <meta name="google-site-verification">).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# URL profil Google Business Profile (untuk sameAs di JSON-LD LocalBusiness).
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Google Analytics 4 (opsional). Kosongkan bila tidak ingin analytics.
NEXT_PUBLIC_GA_ID=
